generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  cpf                String?    @unique
  numero             String?
  phone              String?
  passwordHash       String?
  role               Role       @default(VIEWER)
  status             UserStatus @default(PENDING)
  verificationCode   String?
  codeExpiresAt      DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime   @default(now())
  accounts           Account[]
  sessions           Session[]
  instalacoes        Instalacao[]
  anotacoes          Anotacao[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refreshToken")
  access_token      String? @map("accessToken")
  expires_at        Int?    @map("expiresAt")
  token_type        String? @map("tokenType")
  scope             String?
  id_token          String? @map("idToken")
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Equipamento {
  id          String            @id @default(cuid())
  nome        String
  tipo        String?
  marca       String?
  modelo      String?
  descricao   String?
  serial      String?           @unique
  mac         String?           @unique
  status      StatusEquipamento @default(DISPONIVEL)
  dataEntrada DateTime          @default(now())
  dataSaida   DateTime?
  destino     String?
  tecnicoResponsavel String?
  assinaturaTecnico  String?
  observacoes String?
  qrCode      String?           @unique
  localizacaoAtual String?
  instalacoes Instalacao[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Instalacao {
  id                String      @id @default(cuid())
  equipamentoId     String
  equipamento       Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  tecnicoId         String
  tecnico           User        @relation(fields: [tecnicoId], references: [id])
  dataInstalacao    DateTime    @default(now())
  endereco          String?
  latitude          Float?
  longitude         Float?
  fotoEquipamento   String?
  fotoSerial        String?
  fotoLocal         String?
  fotosAdicionais   String[]
  assinaturaCliente String?
  nomeCliente       String?
  observacoes       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Anotacao {
  id        String   @id @default(cuid())
  texto     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ferramenta {
  id                      String                 @id @default(cuid())
  nome                    String
  categoria               CategoriaFerramenta
  quantidadeTotal         Int                    @default(1)
  quantidadeEmUso         Int                    @default(0)
  status                  StatusFerramenta       @default(DISPONIVEL)
  localizacaoAtual        String?
  observacoes             String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  movimentacoes           MovimentacaoFerramenta[]
}

model MovimentacaoFerramenta {
  id                      String   @id @default(cuid())
  ferramentaId            String
  ferramenta              Ferramenta @relation(fields: [ferramentaId], references: [id], onDelete: Cascade)
  tecnicoId               String?
  tecnicoNome             String
  tipoMovimentacao        TipoMovimentacao
  quantidade              Int      @default(1)
  dataRetirada            DateTime @default(now())
  dataPrevistaDevolucao   DateTime?
  dataDevolucaoReal       DateTime?
  motivo                  String?
  observacoes             String?
  createdAt               DateTime @default(now())
}

model Tecnico {
  id          String         @id @default(cuid())
  nome        String
  telefone    String?
  funcao      String?
  status      StatusTecnico  @default(ATIVO)
  observacoes String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum CategoriaFerramenta {
  ELETRICA
  FIBRA
  MEDICAO
  SEGURANCA
  REDE
  FERRAMENTAS_MANUAIS
  OUTROS
}

enum StatusFerramenta {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
  PERDIDA
}

enum TipoMovimentacao {
  EMPRESTIMO
  DEVOLUCAO
  MANUTENCAO
  PERDA
  TRANSFERENCIA
}

enum StatusTecnico {
  ATIVO
  INATIVO
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  PENDING
  APPROVED
}

enum StatusEquipamento {
  DISPONIVEL
  EM_POSSE_DO_TECNICO
  DESCARTADO
  SAIDA
  RESERVADO
  DEFEITO
  INSTALADO
  EQUIPAMENTO_DE_RETORNO
}
